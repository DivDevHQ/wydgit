[
  {
    "id": "divdev/login",
    "publisher": "divdev",
    "public": true,
    "extends": "wydgit.core/block",
    "properties": {
      "content": {
        "type": "object",
        "default": {
          "type": "markdown",
          "value": ""
        }
      }
    },
    "slots": {},
    "presentation": {
      "schema": "wydgit.presentation/0.1",
      "submission": {
        "library": "wydgate",
        "apiVersion": "1.0.0",
        "operation": "browser-login",
        "input": {}
      },
      "template": {
        "tag": "form",
        "attrs": {
          "id": {
            "get": "id"
          },
          "method": "post",
          "action": {
            "op": "url",
            "path": {
              "get": "transfer"
            },
            "params": [
              [
                "_csrf",
                {
                  "get": "csrf"
                }
              ]
            ]
          }
        },
        "children": [
          {
            "tag": "label",
            "attrs": {
              "for": {
                "op": "concat",
                "args": [
                  {
                    "get": "id"
                  },
                  "-username"
                ]
              }
            },
            "text": "Username"
          },
          {
            "tag": "input",
            "attrs": {
              "id": {
                "op": "concat",
                "args": [
                  {
                    "get": "id"
                  },
                  "-username"
                ]
              },
              "name": "username",
              "type": "text",
              "autocomplete": "username",
              "required": true,
              "maxlength": 128
            }
          },
          {
            "tag": "label",
            "attrs": {
              "for": {
                "op": "concat",
                "args": [
                  {
                    "get": "id"
                  },
                  "-password"
                ]
              }
            },
            "text": "Password"
          },
          {
            "tag": "input",
            "attrs": {
              "id": {
                "op": "concat",
                "args": [
                  {
                    "get": "id"
                  },
                  "-password"
                ]
              },
              "name": "password",
              "type": "password",
              "autocomplete": "current-password",
              "required": true,
              "maxlength": 256
            }
          },
          {
            "tag": "button",
            "attrs": {
              "type": "submit"
            },
            "text": "Login"
          }
        ]
      }
    }
  },
