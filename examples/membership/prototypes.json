  {
    "id": "divdev/member-list",
    "publisher": "divdev",
    "public": true,
    "extends": "wydgit.core/block",
    "properties": {
      "content": {
        "type": "object",
        "default": {
          "type": "markdown",
          "value": ""
        }
      }
    },
    "slots": {},
    "presentation": {
      "schema": "wydgit.presentation/0.1",
      "request": {
        "library": "wydgate",
        "apiVersion": "1.0.0",
        "operation": "list-members",
        "input": {
          "limit": 20
        }
      },
      "template": {
        "tag": "section",
        "attrs": {
          "id": {
            "get": "id"
          },
          "aria-label": "App members"
        },
        "children": [
          {
            "tag": "p",
            "attrs": {
              "role": "status"
            },
            "text": "Member list unavailable or not authorized.",
            "if": {
              "op": "eq",
              "args": [
                {
                  "get": "data.state"
                },
                "error"
              ]
            }
          },
          {
            "tag": "ul",
            "children": [
              {
                "tag": "li",
                "each": {
                  "in": {
                    "get": "data.value.members"
                  },
                  "as": "item"
                },
                "text": {
                  "get": "item.displayName"
                }
              }
            ],
            "if": {
              "op": "eq",
              "args": [
                {
                  "get": "data.state"
                },
                "ready"
              ]
            }
          }
        ]
      }
    }
  },
