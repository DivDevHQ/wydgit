  {
    "id": "wydgit.core/form",
    "publisher": "wydgit.core",
    "public": true,
    "extends": "wydgit.core/section",
    "properties": {
      "content": {
        "type": "object",
        "default": {
          "type": "markdown",
          "value": ""
        }
      },
      "label": {
        "type": "string",
        "default": "Submit"
      },
      "valid": {
        "type": "boolean",
        "default": true
      },
      "errors": {
        "type": "array",
        "default": []
      },
      "warnings": {
        "type": "array",
        "default": []
      }
    },
    "slots": {},
    "behaviorSource": "FUNCTION Validate() AS Boolean\n RETURN Me.FormState(\"validate\")\nEND FUNCTION\nFUNCTION IsValid() AS Boolean\n RETURN Me.FormState(\"isValid\")\nEND FUNCTION\nFUNCTION Values() AS Object\n RETURN Me.FormState(\"values\")\nEND FUNCTION\nSUB Bind(data AS Object)\n Me.FormState(\"bind\", data)\nEND SUB\nSUB Clear()\n Me.FormState(\"clear\")\nEND SUB"
  },
