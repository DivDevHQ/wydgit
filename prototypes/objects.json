        "ordered": true
      }
    },
    "extends": "wydgit.core/object"
  },
  {
    "id": "wydgit.core/block",
    "publisher": "wydgit.core",
    "public": true,
    "properties": {
      "anchors": {
        "type": "array",
        "default": []
      },
      "content": {
        "type": "object",
        "required": true,
        "supported-types": [
          "markdown"
        ]
      },
      "skin": {
        "type": "string",
        "description": "Optional skin ID. Its tokens override inherited site/page/section tokens; omitted tokens keep the parent values."
      },
      "linkToPage": {
        "type": "string",
        "description": "Page ID, resolved like navigation.items[].page. Required for whole-card-link; optional for card (adds a separate page link)."
      }
    },
    "slots": {
      "children": {
        "accepts": [
          "wydgit.core/block",
          "wydgit.core/section",
          "wydgit.core/field"
        ],
        "ordered": true
      }
    },
    "extends": "wydgit.core/object"
  },
