{
  "prototype": "site",
  "class": "WydgitSite",
  "version": "0.1",
  "properties": {
    "id": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "position": {
      "type": "string",
      "default": "main",
      "enum": [
        "header",
        "main",
        "aside",
        "footer"
      ]
    },
    "format": {
      "type": "object",
      "default": {}
    },
    "title": {
      "type": "string",
      "required": true
    },
    "home": {
      "type": "string",
      "required": true
    },
    "pages": {
      "type": "array",
      "required": true
    },
    "navigation": {
      "type": "array",
      "default": []
    },
    "tagline": {
      "type": "string",
      "default": ""
    },
    "footer": {
      "type": "string",
      "default": ""
    },
    "revision": {
      "type": "string",
      "default": ""
    },
    "skin": {
      "type": "string",
      "description": "Optional skin ID. Its tokens override inherited site/page/section tokens; omitted tokens keep the parent values."
    },
    "logoText": {
      "type": "string",
      "default": "",
      "description": "Optional decorative letter mark beside the site title."
    },
    "themeMode": {
      "type": "string",
      "default": "system",
      "enum": [
        "system",
        "light",
        "dark"
      ]
    }
  },
  "format": {
    "align": [
      "start",
      "center",
      "end"
    ],
    "width": [
      "normal",
      "wide",
      "narrow"
    ],
    "layout": [
      "flow",
      "cards",
      "columns"
    ],
    "tone": [
      "plain",
      "hero",
      "muted"
    ],
    "presentation": [
      "prose",
      "card",
      "pullquote"
    ]
  }
}
