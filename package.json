{
  "name": "wydgit",
  "version": "0.3.0-alpha.17",
  "description": "A portable, capability-safe application platform for the open web",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "wydgine": "node packages/wydgine/bin/wydgine.js",
    "wydhosting": "node packages/wydhosting/bin/wydhosting.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "check": "node scripts/check-content.js",
    "build:client": "node scripts/build-regex.js && node packages/wydclient/build.js",
    "pretest": "npm run build:client",
    "test:client": "npm run build:client && node --test --test-isolation=none packages/wydclient/test/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "busboy": "1.6.0",
    "hono": "4.13.13",
    "marked": "^15.0.12",
    "re2js": "2.8.6",
    "sanitize-html": "^2.18.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "cheerio": "1.0.0",
    "esbuild": "0.25.12",
    "happy-dom": "20.8.9"
  },
  "workspaces": [
    "packages/*"
  ],
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true
  }
}
