(typeattributeset systemd_unit_file_type (wydhosting_broker_unit_t))
(roletype object_r wydhosting_broker_state_t)
(roletype object_r wydhosting_broker_approval_t)
(roletype object_r wydhosting_upload_t)
(roletype object_r wydhosting_account_t)
(roletype object_r wydhosting_broker_unit_t)
(roletype object_r wydhosting_account_temp_t)
