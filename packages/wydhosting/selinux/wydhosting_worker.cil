; EXPERIMENTAL provider/worker policy. Administrator installs explicitly; no install hook.
; Categories are allocated in the root-reviewed approval, never by a worker.
(type wydhosting_worker_t)
(typeattributeset domain (wydhosting_worker_t))
(typeattributeset mcs_constrained_type (wydhosting_worker_t))
(roletype system_r wydhosting_worker_t)
(type wydhosting_runtime_t)
(type wydhosting_root_t)
(type wydhosting_code_t)
(type wydhosting_data_t)
(type wydhosting_control_t)
(type wydhosting_run_t)
(typeattributeset file_type (wydhosting_runtime_t wydhosting_root_t wydhosting_code_t wydhosting_data_t wydhosting_control_t wydhosting_run_t))
(roletype object_r wydhosting_runtime_t)
(roletype object_r wydhosting_root_t)
(roletype object_r wydhosting_code_t)
(roletype object_r wydhosting_data_t)
(roletype object_r wydhosting_control_t)
(roletype object_r wydhosting_run_t)
(filecon "/opt/wydhosting/release(/.*)?" any (system_u object_r wydhosting_runtime_t ((s0) (s0))))
(filecon "/var/lib/wydhosting" dir (system_u object_r wydhosting_root_t ((s0) (s0))))
(filecon "/var/lib/wydhosting/pools" dir (system_u object_r wydhosting_root_t ((s0) (s0))))
(filecon "/run/wydhosting" dir (system_u object_r wydhosting_control_t ((s0) (s0))))
(filecon "/run/wydhosting/workers" dir (system_u object_r wydhosting_run_t ((s0) (s0))))
(allow init_t wydhosting_root_t (dir (mounton)))
(allow init_t wydhosting_code_t (dir (mounton)))
(allow init_t wydhosting_data_t (dir (mounton)))
(allow init_t wydhosting_control_t (dir (mounton)))
(allow init_t wydhosting_run_t (dir (mounton)))
; Manager access is restricted to these new hosting object types.
(allow init_t wydhosting_root_t (dir (search getattr)))
(allow init_t wydhosting_code_t (dir (search getattr)))
(allow init_t wydhosting_runtime_t (dir (search getattr)))
(allow init_t wydhosting_runtime_t (file (open read getattr execute map)))
(allow init_t wydhosting_control_t (dir (search open read write getattr setattr add_name remove_name)))
(allow init_t wydhosting_control_t (sock_file (create write getattr setattr unlink)))
(allow init_t wydhosting_run_t (dir (create search open read write getattr setattr add_name remove_name rmdir relabelfrom relabelto)))
; systemd executes the distro Python launcher in the requested confined context.
(allow init_t wydhosting_worker_t (process (transition siginh rlimitinh signal sigkill sigstop getattr)))
(allow init_t wydhosting_worker_t (process2 (nnp_transition)))
(allow wydhosting_worker_t bin_t (file (entrypoint execute execute_no_trans open read getattr map)))
(allow wydhosting_worker_t wydhosting_runtime_t (dir (search open read getattr)))
(allow wydhosting_worker_t wydhosting_runtime_t (file (open read getattr map execute execute_no_trans)))
(allow wydhosting_worker_t wydhosting_worker_t (process (fork sigchld signal sigkill sigstop getcap setrlimit execmem getattr)))
(allow wydhosting_worker_t wydhosting_worker_t (unix_stream_socket (create bind listen accept connect read write getattr getopt setopt shutdown)))
(allow wydhosting_worker_t wydhosting_worker_t (unix_dgram_socket (create read write getattr getopt setopt shutdown)))
; The authenticated administrative broker is currently unconfined.
; This allow is not a claim that the broker has a qualified MAC policy.
(allow wydhosting_worker_t unconfined_service_t (unix_stream_socket (connectto)))
(allow wydhosting_worker_t init_t (fd (use)))
(allow wydhosting_worker_t device_t (dir (search getattr)))
(allow wydhosting_worker_t unconfined_service_t (fd (use)))
(allow wydhosting_worker_t wydhosting_root_t (dir (search getattr)))
(allow wydhosting_worker_t wydhosting_code_t (dir (search open read getattr)))
(allow wydhosting_worker_t wydhosting_code_t (file (open read getattr map)))
(allow wydhosting_worker_t wydhosting_data_t (dir (create search open read write getattr setattr add_name remove_name rmdir rename)))
(allow wydhosting_worker_t wydhosting_data_t (file (create open read write append getattr setattr lock unlink rename map)))
(allow wydhosting_worker_t wydhosting_control_t (dir (search open read getattr)))
(allow wydhosting_worker_t wydhosting_control_t (file (open read getattr)))
(allow wydhosting_worker_t wydhosting_control_t (sock_file (write getattr)))
(allow wydhosting_worker_t wydhosting_run_t (dir (search open read write getattr add_name remove_name)))
(allow wydhosting_worker_t wydhosting_run_t (sock_file (create read write getattr setattr unlink)))
; Runtime system dependencies: read-only loader/Python/locale; no generic file_type.
(allow wydhosting_worker_t root_t (dir (search getattr)))
(allow wydhosting_worker_t usr_t (dir (search getattr)))
(allow wydhosting_worker_t bin_t (dir (search getattr)))
(allow wydhosting_worker_t lib_t (dir (search open read getattr)))
(allow wydhosting_worker_t lib_t (file (open read getattr map execute)))
(allow wydhosting_worker_t lib_t (lnk_file (read getattr)))
(allow wydhosting_worker_t ld_so_t (file (open read getattr map execute)))
(allow wydhosting_worker_t ld_so_cache_t (file (open read getattr map)))
(allow wydhosting_worker_t etc_t (dir (search getattr)))
(allow wydhosting_worker_t etc_t (lnk_file (read getattr)))
(allow wydhosting_worker_t cert_t (dir (search open read getattr)))
(allow wydhosting_worker_t cert_t (lnk_file (read getattr)))
(allow wydhosting_worker_t cert_t (file (open read getattr)))
(allow wydhosting_worker_t usr_t (file (open read getattr)))
(allow wydhosting_worker_t locale_t (dir (search open read getattr)))
(allow wydhosting_worker_t locale_t (file (open read getattr map)))
(allow wydhosting_worker_t var_t (dir (search getattr)))
(allow wydhosting_worker_t var_lib_t (dir (search getattr)))
(allow wydhosting_worker_t var_run_t (dir (search getattr)))
(allow wydhosting_worker_t proc_t (dir (search getattr)))
(allow wydhosting_worker_t proc_t (file (open read getattr)))
(allow wydhosting_worker_t proc_t (lnk_file (read getattr)))
(allow wydhosting_worker_t wydhosting_worker_t (dir (search open read getattr)))
(allow wydhosting_worker_t wydhosting_worker_t (file (open read getattr)))
(allow wydhosting_worker_t wydhosting_worker_t (lnk_file (read getattr)))
(allow wydhosting_worker_t null_device_t (chr_file (open read write getattr ioctl)))
(allow wydhosting_worker_t urandom_device_t (chr_file (open read getattr)))
(allow wydhosting_worker_t random_device_t (chr_file (open read getattr)))
(allow wydhosting_worker_t tmpfs_t (dir (search open read write getattr add_name remove_name)))
; No capabilities, TCP/UDP sockets, ptrace, relabel, setexec or system writes.

; Provider is separately confined; it can route to tenant sockets but cannot
; modify sealed code, approvals, root leases, account databases or worker labels.
(type wydhosting_provider_t)
(typeattributeset domain (wydhosting_provider_t))
(roletype system_r wydhosting_provider_t)
(type wydhosting_provider_state_t)
(type wydhosting_provider_run_t)
(type wydhosting_provider_config_t)
(typeattributeset file_type (wydhosting_provider_state_t wydhosting_provider_run_t wydhosting_provider_config_t))
(roletype object_r wydhosting_provider_state_t)
(roletype object_r wydhosting_provider_run_t)
(roletype object_r wydhosting_provider_config_t)
(filecon "/var/lib/wydhosting/provider(/.*)?" any (system_u object_r wydhosting_provider_state_t ((s0) (s0))))
(filecon "/etc/wydhosting/provider(-approval)?[.]json" file (system_u object_r wydhosting_provider_config_t ((s0) (s0))))
(filecon "/run/wydhosting/broker[.]sock" any (system_u object_r wydhosting_control_t ((s0) (s0))))
(filecon "/run/wydhosting/provider(/.*)?" any (system_u object_r wydhosting_provider_run_t ((s0) (s0))))
(allow init_t wydhosting_provider_t (process (transition siginh rlimitinh signal sigkill sigstop getattr)))
(allow init_t wydhosting_provider_t (process2 (nnp_transition)))
(allow init_t wydhosting_provider_state_t (dir (search getattr mounton)))
(allow init_t wydhosting_provider_run_t (dir (create search open read write getattr setattr add_name remove_name rmdir mounton)))
(allow init_t wydhosting_provider_run_t (sock_file (getattr setattr unlink)))
(typetransition init_t wydhosting_control_t dir "provider" wydhosting_provider_run_t)
