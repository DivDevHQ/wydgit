(allow wydhosting_broker_t selinux_config_t (file (open read getattr)))

; The fixed systemctl helper detects its root namespace and authenticates to
; systemd's existing private Unix manager endpoint. No system-bus/TCP access.
(allow wydhosting_broker_t init_t (lnk_file (read getattr)))
(allow wydhosting_broker_t init_var_run_t (sock_file (write getattr)))

; Manager builds the existing worker InaccessiblePaths sandbox over this typed
; root state directory; this grants no worker access to broker state.
(allow init_t wydhosting_broker_state_t (dir (mounton)))
