(filecon "/etc/wydhosting/approval[.]json" file (system_u object_r wydhosting_broker_approval_t ((s0) (s0))))
(filecon "/var/lib/wydhosting/uploads(/.*)?" any (system_u object_r wydhosting_upload_t ((s0) (s0))))
