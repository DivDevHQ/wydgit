; No outbound TCP connect/name_connect, UDP, DNS, worker/control access, relabel,
; tenant content, general executable access or system writes.

; Privileged broker TCB. Deliberately not MCS constrained: root-reviewed staging
; labels multiple tenant categories. No unconfined attribute/transition, TCP/UDP,
; generic executable permission, generic file_type access or generic process signal.
(type wydhosting_broker_t)
(typeattributeset domain (wydhosting_broker_t))
(roletype system_r wydhosting_broker_t)
(type wydhosting_broker_state_t)
(type wydhosting_broker_approval_t)
