(roletype object_r wydhosting_root_t)
(roletype object_r wydhosting_code_t)
(roletype object_r wydhosting_data_t)
(roletype object_r wydhosting_control_t)
(roletype object_r wydhosting_run_t)
(filecon "/opt/wydhosting/release(/.*)?" any (system_u object_r wydhosting_runtime_t ((s0) (s0))))
(filecon "/var/lib/wydhosting" dir (system_u object_r wydhosting_root_t ((s0) (s0))))
(filecon "/var/lib/wydhosting/pools" dir (system_u object_r wydhosting_root_t ((s0) (s0))))
