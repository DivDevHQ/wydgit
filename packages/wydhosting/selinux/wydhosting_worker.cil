; Account tools consult the distribution's label database to preserve labels on
; atomic passwd/group replacements; it remains read-only to the broker.
(allow wydhosting_broker_t default_context_t (dir (search open read getattr)))
(allow wydhosting_broker_t default_context_t (file (open read getattr)))
